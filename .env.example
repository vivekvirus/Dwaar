# Dwaar environment variables. Copy to .env (`make setup` does this and generates local keys).
# NEVER put real secrets in this file. Values below are local-development placeholders; real
# environments inject their own through the deployment platform's secret store.
# Precedence: real environment > .env > this file.  Keep one KEY=value per line, no interpolation.
# Add every new variable here, with a comment, in the same change that introduces it.

# --- Runtime mode -------------------------------------------------------------------------
# local | test | staging | production. Simulators (identity issuer, SMS/IVR, payments, hardware,
# AI provider) are only permitted when DWAAR_ENV=local or test, and are always labelled
# simulation=true.
DWAAR_ENV=local
DWAAR_LOG_LEVEL=INFO

# --- PostgreSQL (local dev cluster managed by tools/dev/pg.sh, or infra/docker-compose.yml) -
DWAAR_PG_PORT=55432
DWAAR_DB_NAME=dwaar
# Local-only role passwords (the dev cluster listens on 127.0.0.1 with trust auth). Not secrets.
DWAAR_DB_OWNER_PASSWORD=dwaar-local-owner
DWAAR_DB_APP_PASSWORD=dwaar-local-app
DWAAR_DB_WORKER_PASSWORD=dwaar-local-worker
# Owner: migrations only. App: the API. Worker: background jobs. The API never uses the owner.
DWAAR_DATABASE_OWNER_URL=postgresql://dwaar_owner:dwaar-local-owner@127.0.0.1:55432/dwaar
DWAAR_DATABASE_URL=postgresql://dwaar_app:dwaar-local-app@127.0.0.1:55432/dwaar
DWAAR_DATABASE_WORKER_URL=postgresql://dwaar_worker:dwaar-local-worker@127.0.0.1:55432/dwaar
# PostgreSQL binaries for tools/dev/pg.sh and the test harness (empty = auto-detect).
DWAAR_PG_BIN=

# --- Tests ----------------------------------------------------------------------------------
# Superuser URL of an existing server (CI service container). Empty = the harness starts a
# private ephemeral PostgreSQL cluster per pytest session and tears it down.
DWAAR_TEST_PG_ADMIN_URL=
# Where the harness puts ephemeral clusters when it is not /tmp.
DWAAR_TEST_PG_TMPDIR=

# --- Redis (job broker) ---------------------------------------------------------------------
DWAAR_REDIS_PORT=56379
DWAAR_REDIS_URL=redis://127.0.0.1:56379/0

# --- API service ----------------------------------------------------------------------------
DWAAR_API_HOST=127.0.0.1
DWAAR_API_PORT=8000
DWAAR_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Largest accepted request body in bytes (413 above it). Also enforce a limit at the reverse proxy.
DWAAR_MAX_REQUEST_BODY_BYTES=1048576
# How long a stored Idempotency-Key response is kept at least (seconds; default 7 days > the 72 h offline buffer).
DWAAR_IDEMPOTENCY_TTL_SECONDS=604800

# --- Identity (IAM-14: standard OIDC/JWT, no invented token formats) ------------------------
# Empty issuer in local/test = the labelled simulator issuer. For a real IdP set all three.
DWAAR_OIDC_ISSUER_URL=
DWAAR_OIDC_AUDIENCE=dwaar-api
DWAAR_OIDC_JWKS_URL=
# IAM-08: reject access tokens whose exp - iat is longer than this (seconds, 60..86400).
DWAAR_ACCESS_TOKEN_MAX_LIFETIME_SECONDS=3600
# Simulator issuer signing seed (Ed25519, base64url 32 bytes). Local/test only.
DWAAR_SIM_IDENTITY_SIGNING_KEY=__GENERATE_ED25519__
DWAAR_ACCESS_TOKEN_TTL_SECONDS=900
DWAAR_REFRESH_TOKEN_TTL_SECONDS=2592000
DWAAR_OTP_TTL_SECONDS=300

# --- PII protection (field-level envelope encryption + lookup tokens) -----------------------
# id=base64url(32 bytes) pairs, comma separated; the active id encrypts new values, the rest
# only decrypt (rotation). Local simulated KMS: production uses a managed KMS adapter.
DWAAR_PII_KEYS=k1=__GENERATE_KEY__
DWAAR_PII_ACTIVE_KEY_ID=k1
# HMAC keys (base64url 32 bytes): phone lookup token and OTP hashing.
DWAAR_PHONE_HASH_KEY=__GENERATE_KEY__
DWAAR_OTP_HASH_KEY=__GENERATE_KEY__

# --- Edge gateway ---------------------------------------------------------------------------
DWAAR_EDGE_DB_PATH=.local/edge/edge.sqlite
DWAAR_EDGE_DEVICE_ID=
DWAAR_EDGE_API_URL=http://127.0.0.1:8000
# Device event-signing key (Ed25519 seed, base64url) and its key id.
DWAAR_EDGE_SIGNING_KEY_ID=edge-local-1
DWAAR_EDGE_SIGNING_KEY=__GENERATE_ED25519__
# Policy snapshot issuer (cloud side). The edge only holds the matching public key.
DWAAR_POLICY_ISSUER_KEY_ID=policy-local-1
DWAAR_POLICY_ISSUER_KEY=__GENERATE_ED25519__

# --- AI gateway (INV-06: AI proposes, deterministic services execute) -----------------------
DWAAR_AI_GATEWAY_URL=http://127.0.0.1:8100
# simulator = deterministic labelled provider (no network). A real provider adapter additionally
# needs its key AND privacy-owner approval of model, region, retention and training terms (D-18).
DWAAR_AI_PROVIDER=simulator
ANTHROPIC_API_KEY=
DWAAR_AI_DAILY_BUDGET_PAISE_PER_SOCIETY=0

# --- External providers: simulators by default, disabled until commercially confirmed ------
DWAAR_NOTIFY_PROVIDER=simulator
DWAAR_PAYMENT_PROVIDER=simulator
DWAAR_HARDWARE_PROVIDER=simulator

# --- Files and observability ----------------------------------------------------------------
DWAAR_FILE_STORE_DIR=.local/files
DWAAR_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Law packs (GOV-01) -------------------------------------------------------------------
# Approval evidence for packs: `id@version=sha256:<hash>` entries separated by ';' (hash from
# `python -m dwaar_packs pin <pack file>`). Empty = no pack is binding. Set only after counsel/CA
# sign-off; never derived from the pack file itself.
DWAAR_PACK_APPROVALS=
# Alternative pack directory; honoured ONLY when DWAAR_ENV is local or test.
DWAAR_PACKS_ROOT=
