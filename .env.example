# Dwaar environment variables. Copy to .env (`make setup` does this and generates local keys).
# NEVER put real secrets in this file. Values below are local-development placeholders; real
# environments inject their own through the deployment platform's secret store.
# Precedence: real environment > .env > this file.  Keep one KEY=value per line, no interpolation.
# Add every new variable here, with a comment, in the same change that introduces it.

# --- Runtime mode -------------------------------------------------------------------------
# local | test | staging | production. Simulators (identity issuer, SMS/IVR, payments, hardware,
# AI provider) are only permitted when DWAAR_ENV=local or test, and are always labelled
# simulation=true.
DWAAR_ENV=local
DWAAR_LOG_LEVEL=INFO

# --- PostgreSQL (local dev cluster managed by tools/dev/pg.sh, or infra/docker-compose.yml) -
DWAAR_PG_PORT=55432
DWAAR_DB_NAME=dwaar
# Local-only role passwords (the dev cluster listens on 127.0.0.1 with trust auth). Not secrets.
DWAAR_DB_OWNER_PASSWORD=dwaar-local-owner
DWAAR_DB_APP_PASSWORD=dwaar-local-app
DWAAR_DB_WORKER_PASSWORD=dwaar-local-worker
# Connection pool and timeouts of the API (the timeouts are PINNED in the connection startup options, so a
# role-level `ALTER ROLE ... SET` cannot override them).
DWAAR_DB_POOL_SIZE=5
DWAAR_DB_MAX_OVERFLOW=10
DWAAR_DB_STATEMENT_TIMEOUT_MS=30000
DWAAR_DB_LOCK_TIMEOUT_MS=15000
# Owner: migrations only. App: the API. Worker: background jobs. The API never uses the owner.
DWAAR_DATABASE_OWNER_URL=postgresql://dwaar_owner:dwaar-local-owner@127.0.0.1:55432/dwaar
DWAAR_DATABASE_URL=postgresql://dwaar_app:dwaar-local-app@127.0.0.1:55432/dwaar
DWAAR_DATABASE_WORKER_URL=postgresql://dwaar_worker:dwaar-local-worker@127.0.0.1:55432/dwaar
# PostgreSQL binaries for tools/dev/pg.sh and the test harness (empty = auto-detect).
DWAAR_PG_BIN=
# Where tools/dev/pg.sh keeps the dev cluster (empty = .local/pg under the repository).
DWAAR_PG_ROOT=
# Migration files directory (empty = the migrations shipped inside the installed package, else services/api/migrations).
DWAAR_MIGRATIONS_DIR=

# --- Tests ----------------------------------------------------------------------------------
# Superuser URL of an existing server (CI service container). Empty = the harness starts a
# private ephemeral PostgreSQL cluster per pytest session and tears it down.
DWAAR_TEST_PG_ADMIN_URL=
# Where the harness puts ephemeral clusters when it is not /tmp.
DWAAR_TEST_PG_TMPDIR=

# --- Redis (job broker) ---------------------------------------------------------------------
DWAAR_REDIS_PORT=56379
DWAAR_REDIS_URL=redis://127.0.0.1:56379/0

# --- API service ----------------------------------------------------------------------------
DWAAR_API_HOST=127.0.0.1
DWAAR_API_PORT=8000
DWAAR_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# HMAC key that signs pagination cursors. REQUIRED outside local/test: at least 32 random characters, for example
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Local/test have a built-in placeholder.
# DWAAR_CURSOR_SIGNING_KEY=
# Page size ceiling and the widest date range a list endpoint accepts.
DWAAR_MAX_PAGE_SIZE=100
DWAAR_MAX_DATE_RANGE_DAYS=92
# Largest accepted request body in bytes (413 above it). Also enforce a limit at the reverse proxy.
DWAAR_MAX_REQUEST_BODY_BYTES=1048576
# How long a stored Idempotency-Key response is kept at least (seconds; default 7 days > the 72 h offline buffer).
DWAAR_IDEMPOTENCY_TTL_SECONDS=604800

# --- Identity (IAM-14: standard OIDC/JWT, no invented token formats) ------------------------
# Empty issuer in local/test = the labelled simulator issuer. For a real IdP set all three.
DWAAR_OIDC_ISSUER_URL=
DWAAR_OIDC_AUDIENCE=dwaar-api
DWAAR_OIDC_JWKS_URL=
# Asymmetric algorithms only (never none or HS*), and the clock leeway in seconds.
DWAAR_OIDC_ALGORITHMS=RS256,ES256,EdDSA
DWAAR_OIDC_LEEWAY_SECONDS=30
# IAM-08: reject access tokens whose exp - iat is longer than this (seconds, 60..86400).
DWAAR_ACCESS_TOKEN_MAX_LIFETIME_SECONDS=3600
# Simulator issuer signing seed (Ed25519, base64url 32 bytes). Local/test only. NOT read by the identity module (ADR-0011
# uses DWAAR_SIM_ISSUER_KEY below); kept until the platform step removes it.
DWAAR_SIM_IDENTITY_SIGNING_KEY=__GENERATE_ED25519__
DWAAR_ACCESS_TOKEN_TTL_SECONDS=900
DWAAR_REFRESH_TOKEN_TTL_SECONDS=2592000
DWAAR_OTP_TTL_SECONDS=300

# --- Identity module (ADR-0011: OTP sign-in, sessions, MFA, memberships) ------------------------------
# Simulator issuer key: base64 of a PEM Ed25519 private key. Empty = a fresh ephemeral key per API process (tokens die on
# restart); set it when more than one API worker runs locally. The simulator only exists when DWAAR_ENV is local or test
# AND DWAAR_OIDC_ISSUER_URL is empty. Never used elsewhere.
DWAAR_SIM_ISSUER_KEY=
# Issuer name the simulator puts in its tokens and OIDC discovery document.
DWAAR_SIM_ISSUER=urn:dwaar:simulator
# OTP: wrong-code attempts per challenge (1..10) and the DLT template id of the OTP SMS (simulated delivery only until a real
# SMS gateway and an approved DLT template exist: blocked-external).
DWAAR_OTP_MAX_ATTEMPTS=5
DWAAR_OTP_DLT_TEMPLATE_ID=SIM-DLT-OTP-LOGIN
# How long a TOTP step-up stays fresh in a session (seconds, 300..86400) and how long a number may sit unused before a
# login on it is treated as a recycled number (days, 7..3650, IAM-11).
DWAAR_MFA_TTL_SECONDS=28800
DWAAR_PHONE_DORMANCY_DAYS=90

# --- PII protection (field-level envelope encryption + lookup tokens) -----------------------
# id=base64url(32 bytes) pairs, comma separated; the active id encrypts new values, the rest
# only decrypt (rotation). Local simulated KMS: production uses a managed KMS adapter.
DWAAR_PII_KEYS=k1=__GENERATE_KEY__
DWAAR_PII_ACTIVE_KEY_ID=k1
# HMAC key (base64url 32 bytes) of the phone lookup token and of the OTP/refresh hashes (ADR-0011). REQUIRED outside
# local/test. Local/test fall back to a fixed placeholder; once real people exist in a database changing it makes every
# stored number unfindable (db-reset and seed again in development).
DWAAR_PHONE_HMAC_KEY=__GENERATE_KEY__
# Not read by any module (superseded by DWAAR_PHONE_HMAC_KEY); kept until the platform step removes them.
DWAAR_PHONE_HASH_KEY=__GENERATE_KEY__
DWAAR_OTP_HASH_KEY=__GENERATE_KEY__

# --- Edge sync, cloud side (slice 3, ADR-0017 / ADR-0019) ----------------------------------------
# Policy issuer: signs every policy snapshot the on-site gateways verify. Ed25519 seed (base64url, 32 bytes). `make setup` generates a
# local one. Local/test fall back to a public-label derived key when empty (SIMULATION only); every other environment answers 503 on the
# edge endpoints without it. Production: a managed KMS/HSM adapter behind the same interface (blocked-external).
DWAAR_EDGE_POLICY_SIGNING_KEY=__GENERATE_ED25519__
# Optional key id printed on every snapshot (default: derived from the public key). Letters, digits, . _ - up to 64.
DWAAR_EDGE_POLICY_KEY_ID=
# Rotated-out issuer PUBLIC keys that gateways may still need to verify older snapshots: `id:publickey_b64url` pairs, comma separated.
# Rotation = put the new seed in DWAAR_EDGE_POLICY_SIGNING_KEY, list the old public key here, then RE-PROVISION each gateway
# (`python -m dwaar_edge.provision`): a gateway never takes a key from a snapshot.
DWAAR_EDGE_RETIRED_KEYS=
# Keyed hash (base64url, 32 bytes) behind the opaque credential_ref / person_ref in snapshots. REQUIRED outside local/test. Changing it
# re-issues every reference (all cached resident credentials become unknown until the next snapshot is applied).
DWAAR_EDGE_REF_KEY=__GENERATE_KEY__
# true = a gateway's policy poll may publish a fresh snapshot (default until the worker publisher runs); false once `dwaar_worker` publishes.
DWAAR_EDGE_PUBLISH_ON_POLL=true
# Per-device request budget (token bucket): burst size and refill per second. Defaults 60 and 5.
DWAAR_EDGE_RATE_CAPACITY=60
DWAAR_EDGE_RATE_REFILL_PER_S=5
# Seed: the synthetic gateways, standing rules and first snapshots are on by default; 0/false/no/off switches them off.
DWAAR_SEED_EDGE=1

# --- Edge gateway, on-site (services/edge; commissioning values, `python -m dwaar_edge`) -------------------------
# Never commit real values: the installer writes these on the gateway. Run `python -m dwaar_edge.provision` to obtain the two pinned key lists.
DWAAR_EDGE_SOCIETY_ID=
DWAAR_EDGE_DEVICE_ID=
# Local disk only (SQLite WAL, synchronous=FULL; a network share is refused).
DWAAR_EDGE_DATA_DIR=.local/edge
# This gateway's own Ed25519 seed (base64url) and its key id. The PUBLIC half is what the supervisor approves in the enrolment request.
DWAAR_EDGE_DEVICE_KEY=__GENERATE_ED25519__
DWAAR_EDGE_DEVICE_KEY_ID=edge-local-1
# Pinned trust anchors from provisioning: `key_id=publickey_b64url,...` (policy issuers) and the guest-pass QR verification keys.
DWAAR_EDGE_ISSUER_KEYS=
DWAAR_EDGE_PASS_KEYS=
# Field encryption of sensitive local columns: `id=base64url(32 bytes)` pairs and the active id; and the key that signs terminal tokens.
DWAAR_EDGE_PII_KEYS=ek1=__GENERATE_KEY__
DWAAR_EDGE_PII_ACTIVE_KEY_ID=ek1
DWAAR_EDGE_TOKEN_KEY=__GENERATE_ED25519__
# Where the sync worker reaches the cloud (https in deployment; empty = the gateway runs without syncing), and where the LOCAL API listens
# (the security-LAN address at commissioning; 127.0.0.1 by default: no inbound internet port).
DWAAR_EDGE_CLOUD_URL=http://127.0.0.1:8000
DWAAR_EDGE_BIND=127.0.0.1
DWAAR_EDGE_PORT=8780
# true (default) labels the gateway a simulation; the barrier adapter refuses anything else in this build.
DWAAR_EDGE_SIMULATION=true

# --- Worker (services/worker: Dramatiq on Redis; plain job functions run without Redis) ------------------------
# Queue the actors use and the cadence of the periodic jobs (seconds).
DWAAR_WORKER_QUEUE=dwaar
DWAAR_WORKER_POLICY_INTERVAL_S=60
DWAAR_WORKER_SWEEP_INTERVAL_S=60

# --- AI gateway (INV-06: AI proposes, deterministic services execute) -----------------------
DWAAR_AI_GATEWAY_URL=http://127.0.0.1:8100
# (slice 4: the gateway is a library the API calls in-process, ADR-0023; the URL above is kept for the later network deployment.)
# simulator = deterministic labelled provider (no network). A real provider adapter additionally
# needs its key AND privacy-owner approval of model, region, retention and training terms (D-18).
DWAAR_AI_PROVIDER=simulator
ANTHROPIC_API_KEY=
DWAAR_AI_DAILY_BUDGET_PAISE_PER_SOCIETY=0
# The ONLY switch for the real Anthropic adapter (ADR-0023). Empty = the adapter is "not configured" and every model path is the
# labelled simulator (local/test only). Never commit a value. Using it also needs privacy-owner approval of the sub-processor (D-18, [VERIFY]).
DWAAR_AI_ANTHROPIC_API_KEY=
# ASSUMED USD->INR planning rate behind cost_paise of real provider runs ([VERIFY] with finance). 1..1000, default 85. Simulator runs cost 0.
DWAAR_AI_USD_INR=85
# Directory of the versioned prompt files (empty = packages/prompts in the source tree or the bundled copy).
DWAAR_PROMPTS_DIR=

# --- External providers: simulators by default, disabled until commercially confirmed ------
DWAAR_NOTIFY_PROVIDER=simulator
DWAAR_PAYMENT_PROVIDER=simulator
DWAAR_HARDWARE_PROVIDER=simulator

# --- i18n ------------------------------------------------------------------------------------
# Directory of the message catalogues (empty = the catalogues bundled in the dwaar-common wheel, else
# packages/i18n/locales in the source tree).
DWAAR_LOCALES_DIR=

# --- Files and observability ----------------------------------------------------------------
DWAAR_FILE_STORE_DIR=.local/files
DWAAR_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Law packs (GOV-01) -------------------------------------------------------------------
# Approval evidence for packs: `id@version=sha256:<hash>` entries separated by ';' (hash from
# `python -m dwaar_packs pin <pack file>`). Empty = no pack is binding. Set only after counsel/CA
# sign-off; never derived from the pack file itself.
DWAAR_PACK_APPROVALS=
# Alternative pack directory; honoured ONLY when DWAAR_ENV is local or test.
DWAAR_PACKS_ROOT=

# --- Visits module (slice 2). Local development values are generated by `make setup`; production comes from the secret store.
# Ed25519 key that signs visitor-pass QR payloads (PRD GATE-01) and its key id.
DWAAR_PASS_SIGNING_KEY=__GENERATE_ED25519__
DWAAR_PASS_KEY_ID=
# HMAC key for visitor contact tokens (keyed hash; raw phone numbers are never stored in visit rows).
DWAAR_VISITOR_HMAC_KEY=__GENERATE_KEY__

# --- Notifications and calling (slice 4, ADR-0020) ------------------------------------------------------------------------
# `simulator` selects the LABELLED simulated push/IVR/SMS/WhatsApp providers and is honoured ONLY when DWAAR_ENV is local or test.
# Empty = no provider configured: the cascade records provider_not_configured and the guard board shows the intercom/office path.
DWAAR_NOTIFICATION_PROVIDERS=simulator
# Comma-separated hosts an SMS / WhatsApp deep link may use (https only, no port/query/fragment). Default links.dwaar.example.
DWAAR_NOTIFICATION_LINK_HOSTS=links.dwaar.example
# Lifetime of a masked proxy-call session in seconds (30..600) and how far back the outbox consumer looks for unprocessed events (hours, 1..720).
DWAAR_NOTIFICATION_CALL_TTL_S=120
DWAAR_NOTIFICATION_EVENT_LOOKBACK_H=48
# Share of approval requests that needed a fallback channel above which OPERATIONS (not the society) is told (0.01..1).
DWAAR_NOTIFICATION_FALLBACK_ALERT=0.30
# Cadence in seconds of the notification cascade tick in the worker scheduler (1..60; the cascade steps are >= 10 s apart).
DWAAR_WORKER_NOTIFY_INTERVAL_S=1
# Directory with the message catalogues the notification templates are validated against (empty = packages/i18n/locales).
DWAAR_I18N_DIR=

# --- Community: documents, downloads, polls (slice 4, ADR-0022) -----------------------------------------------------------
# Local-disk object store (simulation=true; development only; empty = a private temporary directory in local/test). No real object store exists yet.
DWAAR_COMMUNITY_STORAGE_DIR=.local/community
# HMAC key (base64url, 32 bytes) of the signed, short-lived download URLs. REQUIRED outside local/test. `make setup` generates one.
DWAAR_COMMUNITY_DOWNLOAD_KEY=__GENERATE_KEY__
# `stub` = the labelled stub malware scanner (EICAR only; accepted ONLY in local/test). Empty = NO scanner: nothing can be published (fail closed).
DWAAR_COMMUNITY_SCANNER=stub
# Seconds a signed download URL stays valid (5..900, default 120).
DWAAR_COMMUNITY_DOWNLOAD_TTL=120
