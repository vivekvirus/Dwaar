{
  "name": "@dwaar/resident-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Dwaar resident app (Expo / React Native + accessible web). REQ: GATE-01, GATE-02, GATE-03, UX-01..07 (partial), INV-05, INV-07",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:check": "node scripts/gen-api.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "build": "expo export --platform web --output-dir dist",
    "e2e": "node e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@dwaar/i18n": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.0",
    "expo-crypto": "~57.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.10.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.50.0",
    "qrcode": "^1.5.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
