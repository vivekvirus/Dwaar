{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fee-schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_type",
    "pack_id",
    "version",
    "status",
    "approved_by",
    "approved_at",
    "effective_from",
    "effective_to",
    "labels",
    "legal_sources",
    "channel",
    "percentage",
    "cap",
    "flat_fee_categories",
    "pass_to_resident",
    "default_rounding"
  ],
  "properties": {
    "pack_type": {
      "const": "fee-schedule"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "unapproved",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "notes": {
      "type": "string"
    },
    "legal_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legal_source"
      }
    },
    "channel": {
      "type": "string"
    },
    "acquirer_classification": {
      "type": "string"
    },
    "percentage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_above_amount_paise",
        "rate_bp"
      ],
      "properties": {
        "applies_above_amount_paise": {
          "type": "integer",
          "minimum": 0
        },
        "rate_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_from_amount_paise",
        "max_fee_paise"
      ],
      "properties": {
        "applies_from_amount_paise": {
          "type": "integer",
          "minimum": 0
        },
        "max_fee_paise": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "flat_fee_categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fee_paise",
        "categories"
      ],
      "properties": {
        "fee_paise": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "p2pm_classification": {
      "type": "object"
    },
    "pass_to_resident": {
      "const": false
    },
    "default_rounding": {
      "enum": [
        "half_up",
        "half_even",
        "up",
        "down"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "LEGAL",
          "VERIFY",
          "CA",
          "TBD"
        ]
      },
      "uniqueItems": true
    },
    "legal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "citation",
        "prd_ref",
        "labels",
        "url"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "prd_ref": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "LEGAL",
              "VERIFY",
              "CA",
              "TBD"
            ]
          },
          "uniqueItems": true
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
