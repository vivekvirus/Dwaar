{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gst-rwa",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_type",
    "pack_id",
    "version",
    "status",
    "approved_by",
    "approved_at",
    "effective_from",
    "effective_to",
    "labels",
    "legal_sources",
    "entity_type",
    "supply_type",
    "exemption",
    "turnover_threshold_paise",
    "gst_rate_bp",
    "requires_ca_classification",
    "rounding"
  ],
  "properties": {
    "pack_type": {
      "const": "gst-rwa"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "unapproved",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "notes": {
      "type": "string"
    },
    "legal_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legal_source"
      }
    },
    "entity_type": {
      "const": "rwa"
    },
    "supply_type": {
      "type": "string"
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_member_per_month_paise",
        "basis_when_above_threshold"
      ],
      "properties": {
        "per_member_per_month_paise": {
          "type": "integer",
          "minimum": 0
        },
        "basis_when_above_threshold": {
          "const": "full_amount"
        }
      }
    },
    "turnover_threshold_paise": {
      "type": "integer",
      "minimum": 0
    },
    "gst_rate_bp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 10000
    },
    "reimbursement_and_pure_agent_heads": {
      "type": "string"
    },
    "requires_ca_classification": {
      "const": true
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "unit_paise"
      ],
      "properties": {
        "mode": {
          "enum": [
            "half_up",
            "half_even",
            "up",
            "down"
          ]
        },
        "unit_paise": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "LEGAL",
          "VERIFY",
          "CA",
          "TBD"
        ]
      },
      "uniqueItems": true
    },
    "legal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "citation",
        "prd_ref",
        "labels",
        "url"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "prd_ref": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "LEGAL",
              "VERIFY",
              "CA",
              "TBD"
            ]
          },
          "uniqueItems": true
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
