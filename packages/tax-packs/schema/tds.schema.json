{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tds",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_type",
    "pack_id",
    "version",
    "status",
    "approved_by",
    "approved_at",
    "effective_from",
    "effective_to",
    "labels",
    "legal_sources",
    "trigger_date_basis",
    "rounding",
    "threshold_comparison",
    "missing_pan",
    "lower_deduction_certificate",
    "cumulative_thresholds",
    "legacy_aliases",
    "categories"
  ],
  "properties": {
    "pack_type": {
      "const": "tds"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "unapproved",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "notes": {
      "type": "string"
    },
    "legal_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legal_source"
      }
    },
    "trigger_date_basis": {
      "const": "credit_or_payment"
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "unit_paise"
      ],
      "properties": {
        "mode": {
          "enum": [
            "half_up",
            "half_even",
            "up",
            "down"
          ]
        },
        "unit_paise": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "threshold_comparison": {
      "enum": [
        "gt",
        "gte"
      ]
    },
    "missing_pan": {
      "type": "object",
      "required": [
        "rate_bp"
      ],
      "additionalProperties": false,
      "properties": {
        "rate_bp": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lower_deduction_certificate": {
      "type": "object",
      "required": [
        "supported",
        "nil_allowed"
      ],
      "additionalProperties": true
    },
    "cumulative_thresholds": {
      "type": "object",
      "required": [
        "supported"
      ],
      "additionalProperties": true
    },
    "challan_and_returns": {
      "type": "object"
    },
    "legacy_aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/alias"
      }
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "LEGAL",
          "VERIFY",
          "CA",
          "TBD"
        ]
      },
      "uniqueItems": true
    },
    "legal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "citation",
        "prd_ref",
        "labels",
        "url"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "prd_ref": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "LEGAL",
              "VERIFY",
              "CA",
              "TBD"
            ]
          },
          "uniqueItems": true
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "category",
        "historical",
        "valid_through"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^\\d{3}[A-Z]?$"
        },
        "category": {
          "type": "string"
        },
        "historical": {
          "const": true
        },
        "valid_through": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "section_ref",
        "legal_source_ref",
        "labels",
        "payees",
        "thresholds"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "section_ref": {
          "type": "string"
        },
        "legal_source_ref": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "payees": {
          "type": "object",
          "required": [
            "individual_huf",
            "others"
          ],
          "additionalProperties": false,
          "properties": {
            "individual_huf": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rate_bp"
              ],
              "properties": {
                "rate_bp": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            },
            "others": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rate_bp"
              ],
              "properties": {
                "rate_bp": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "single_payment_paise",
            "aggregate_per_financial_year_paise",
            "aggregate_crossing_basis"
          ],
          "properties": {
            "single_payment_paise": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "aggregate_per_financial_year_paise": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "aggregate_crossing_basis": {
              "enum": [
                "payment_amount",
                "cumulative_amount",
                null
              ]
            }
          }
        }
      }
    }
  }
}
