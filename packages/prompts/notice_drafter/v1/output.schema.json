{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-C01 output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body",
    "language",
    "threatening_flags",
    "missing_fields",
    "translations"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "maxLength": 6000
    },
    "language": {
      "enum": [
        "en",
        "hi",
        "mr"
      ]
    },
    "threatening_flags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span",
          "reason"
        ],
        "properties": {
          "span": {
            "type": "string",
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "translations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "title",
          "body"
        ],
        "properties": {
          "language": {
            "enum": [
              "en",
              "hi",
              "mr"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 6000
          }
        }
      }
    }
  }
}
