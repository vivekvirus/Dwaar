{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-C12 output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bias_flags",
    "neutral_wording",
    "options",
    "changed",
    "summary_reason"
  ],
  "properties": {
    "bias_flags": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span",
          "kind",
          "reason"
        ],
        "properties": {
          "span": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "leading_question",
              "loaded_term",
              "double_barrelled",
              "missing_option",
              "ambiguous_scope",
              "pressure"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "neutral_wording": {
      "type": "string",
      "maxLength": 1500
    },
    "options": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "changed": {
      "type": "boolean"
    },
    "summary_reason": {
      "type": "string",
      "maxLength": 400
    }
  }
}
