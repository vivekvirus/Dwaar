{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "legal-pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_type",
    "pack_id",
    "version",
    "status",
    "approved_by",
    "approved_at",
    "effective_from",
    "effective_to",
    "labels",
    "legal_sources",
    "jurisdiction",
    "entity_type",
    "enabled",
    "rules"
  ],
  "properties": {
    "pack_type": {
      "const": "legal-pack"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "unapproved",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "notes": {
      "type": "string"
    },
    "legal_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legal_source"
      }
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^IN(-[A-Z]{2})?$"
    },
    "entity_type": {
      "enum": [
        "chs",
        "apartment_assoc",
        "society_reg",
        "company",
        "any"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "disabled_reason": {
      "type": "string"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configurable_by": {
          "const": "secretary"
        },
        "legal_reference_required": {
          "type": "boolean"
        },
        "counsel_approval_required": {
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "LEGAL",
          "VERIFY",
          "CA",
          "TBD"
        ]
      },
      "uniqueItems": true
    },
    "legal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "citation",
        "prd_ref",
        "labels",
        "url"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "prd_ref": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "LEGAL",
              "VERIFY",
              "CA",
              "TBD"
            ]
          },
          "uniqueItems": true
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "labels",
        "legal_source_ref"
      ],
      "properties": {
        "value": {},
        "unit": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "legal_source_ref": {
          "type": "string"
        },
        "legal_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "configurable": {
          "type": "boolean"
        }
      }
    }
  }
}
