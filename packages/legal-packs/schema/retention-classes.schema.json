{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "retention",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_type",
    "pack_id",
    "version",
    "status",
    "approved_by",
    "approved_at",
    "effective_from",
    "effective_to",
    "labels",
    "legal_sources",
    "jurisdiction",
    "classes"
  ],
  "properties": {
    "pack_type": {
      "const": "retention"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "unapproved",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_review": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "notes": {
      "type": "string"
    },
    "legal_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legal_source"
      }
    },
    "jurisdiction": {
      "type": "string"
    },
    "classes": {
      "type": "object",
      "required": [
        "VIS",
        "VISPH",
        "DEL",
        "ANPR",
        "CRED",
        "RES",
        "STF",
        "FIN",
        "LOG",
        "BKP",
        "HOLD"
      ],
      "additionalProperties": false,
      "properties": {
        "VIS": {
          "$ref": "#/$defs/retention_class"
        },
        "VISPH": {
          "$ref": "#/$defs/retention_class"
        },
        "DEL": {
          "$ref": "#/$defs/retention_class"
        },
        "ANPR": {
          "$ref": "#/$defs/retention_class"
        },
        "CRED": {
          "$ref": "#/$defs/retention_class"
        },
        "RES": {
          "$ref": "#/$defs/retention_class"
        },
        "STF": {
          "$ref": "#/$defs/retention_class"
        },
        "FIN": {
          "$ref": "#/$defs/retention_class"
        },
        "LOG": {
          "$ref": "#/$defs/retention_class"
        },
        "BKP": {
          "$ref": "#/$defs/retention_class"
        },
        "HOLD": {
          "$ref": "#/$defs/retention_class"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "approved"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "LEGAL",
          "VERIFY",
          "CA",
          "TBD"
        ]
      },
      "uniqueItems": true
    },
    "legal_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "citation",
        "prd_ref",
        "labels",
        "url"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "prd_ref": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "LEGAL",
              "VERIFY",
              "CA",
              "TBD"
            ]
          },
          "uniqueItems": true
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retention_class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "operational",
        "archive",
        "erasure",
        "legal_source_ref"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "legal_source_ref": {
          "type": "string"
        },
        "operational": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "days",
            "visibility"
          ],
          "properties": {
            "days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "until": {
              "type": "string"
            },
            "extendable_to_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "extension_requires_justification": {
              "type": "boolean"
            },
            "visibility": {
              "type": "string"
            }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "min_days",
            "legal_source_ref"
          ],
          "properties": {
            "scope": {
              "type": "string"
            },
            "min_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expiry_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "legal_source_ref": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "min_days",
                  "legal_source_ref"
                ],
                "additionalProperties": false,
                "properties": {
                  "min_days": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "legal_source_ref": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "erasure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "trigger",
            "unless_hold"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "trigger": {
              "type": "string"
            },
            "unless_hold": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
